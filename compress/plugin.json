{
  "name": "compress",
  "label": "解压压缩",
  "version": "2.0.0",
  "description": "解压/压缩/格式转换/对比(7z)(接口库 v4 迁移)",
  "author": "RainCough",
  "icon": "",
  "frontend": {
    "entry": "assets/plugin.js",
    "vue": "3.5",
    "pages": [
      {
        "path": "",
        "title": "解压压缩"
      }
    ]
  },
  "backend": {
    "lang": "python",
    "exec": [
      "python",
      "server_v4.py"
    ],
    "capabilities": [
      "invoke",
      "heartbeat",
      "log.tail"
    ]
  },
  "interfaces": [
    {
      "id": "compress.dc.check",
      "visibility": "all",
      "version": "1",
      "description": "7z 环境检查"
    },
    {
      "id": "compress.dc.list",
      "visibility": "main",
      "version": "1",
      "description": "压缩包内容列表"
    },
    {
      "id": "compress.dc.extract",
      "visibility": "main",
      "version": "1",
      "description": "解压(支持整理)"
    },
    {
      "id": "compress.dc.compress",
      "visibility": "main",
      "version": "1",
      "description": "压缩(7z/zip/tar.gz等)"
    },
    {
      "id": "compress.dc.convert",
      "visibility": "main",
      "version": "1",
      "description": "格式转换"
    },
    {
      "id": "compress.dc.compare",
      "visibility": "main",
      "version": "1",
      "description": "两压缩包对比"
    },
    {
      "id": "compress.info",
      "visibility": "all",
      "version": "1",
      "description": "插件信息"
    }
  ]
}