{
  "name": "QQBot",
  "label": "QQ Bot",
  "version": "1.1.1",
  "description": "NapCat 协议端 + RainCough Bot 统一控制台",
  "author": "RainCough",
  "icon": "",
  "requirements": [],
  "frontend": {
    "entry": "assets/plugin.js",
    "vue": "3.5",
    "pages": [
      {
        "path": "",
        "title": "QQ Bot"
      }
    ]
  },
  "backend": {
    "lang": "python",
    "exec": [
      "python3",
      "server_v4.py"
    ],
    "capabilities": [
      "invoke",
      "heartbeat",
      "log.tail"
    ]
  },
  "interfaces": [
    {
      "id": "qqbot.health",
      "visibility": "all",
      "version": "1",
      "description": "探活"
    },
    {
      "id": "qqbot.conn.get",
      "visibility": "all",
      "version": "1",
      "description": "读取连接地址与连通性"
    },
    {
      "id": "qqbot.conn.save",
      "visibility": "main",
      "version": "1",
      "description": "保存连接地址"
    },
    {
      "id": "qqbot.nc.overview",
      "visibility": "all",
      "version": "1",
      "description": "NapCat 概览（账号/系统/网络计数）"
    },
    {
      "id": "qqbot.nc.account",
      "visibility": "all",
      "version": "1",
      "description": "QQ 账户状态与二维码"
    },
    {
      "id": "qqbot.nc.action",
      "visibility": "main",
      "version": "1",
      "description": "刷新二维码 / 快速登录 / 重启"
    },
    {
      "id": "qqbot.nc.logs",
      "visibility": "all",
      "version": "1",
      "description": "NapCat 运行日志（实时/历史）"
    },
    {
      "id": "qqbot.nc.logs.clear",
      "visibility": "main",
      "version": "1",
      "description": "清空日志缓冲"
    },
    {
      "id": "rcbot.status",
      "visibility": "all",
      "version": "1",
      "description": "机器人运行状态"
    },
    {
      "id": "rcbot.config.get",
      "visibility": "all",
      "version": "1",
      "description": "读取上下文/触发/能力配置"
    },
    {
      "id": "rcbot.config.save",
      "visibility": "main",
      "version": "1",
      "description": "保存上下文/触发/能力配置"
    },
    {
      "id": "rcbot.tools.search",
      "visibility": "main",
      "version": "1",
      "description": "试一下联网搜索"
    },
    {
      "id": "rcbot.providers",
      "visibility": "all",
      "version": "1",
      "description": "模型提供商列表"
    },
    {
      "id": "rcbot.provider.save",
      "visibility": "main",
      "version": "1",
      "description": "新增/修改提供商"
    },
    {
      "id": "rcbot.provider.delete",
      "visibility": "main",
      "version": "1",
      "description": "删除提供商"
    },
    {
      "id": "rcbot.provider.test",
      "visibility": "main",
      "version": "1",
      "description": "测试提供商连通性"
    },
    {
      "id": "rcbot.provider.models",
      "visibility": "main",
      "version": "1",
      "description": "拉取可用模型列表"
    },
    {
      "id": "rcbot.personas",
      "visibility": "all",
      "version": "1",
      "description": "人格列表"
    },
    {
      "id": "rcbot.persona.save",
      "visibility": "main",
      "version": "1",
      "description": "新增/修改人格"
    },
    {
      "id": "rcbot.persona.delete",
      "visibility": "main",
      "version": "1",
      "description": "删除人格"
    },
    {
      "id": "rcbot.sessions",
      "visibility": "all",
      "version": "1",
      "description": "会话列表"
    },
    {
      "id": "rcbot.session.get",
      "visibility": "all",
      "version": "1",
      "description": "会话详情与消息"
    },
    {
      "id": "rcbot.session.save",
      "visibility": "main",
      "version": "1",
      "description": "修改会话（人格/模型/启停）"
    },
    {
      "id": "rcbot.session.clear",
      "visibility": "main",
      "version": "1",
      "description": "清空会话上下文"
    },
    {
      "id": "rcbot.session.delete",
      "visibility": "main",
      "version": "1",
      "description": "删除会话"
    },
    {
      "id": "rcbot.context",
      "visibility": "all",
      "version": "1",
      "description": "上下文预览（含压缩摘要）"
    },
    {
      "id": "rcbot.test_chat",
      "visibility": "main",
      "version": "1",
      "description": "试聊（不经过 QQ）"
    }
  ]
}
