{
  "name": "JMComic",
  "label": "JMComic",
  "version": "1.00.7",
  "description": "禁漫天堂搜索与漫画阅读(接口库 v4 迁移)",
  "author": "RainCough",
  "icon": "",
  "requirements": [
    "jmcomic>=2.7",
    "requests>=2.31"
  ],
  "frontend": {
    "entry": "assets/plugin.js",
    "vue": "3.5",
    "pages": [
      {
        "path": "",
        "title": "JMComic"
      }
    ]
  },
  "backend": {
    "lang": "python",
    "exec": [
      "python3",
      "server_v4.py"
    ],
    "capabilities": [
      "invoke",
      "heartbeat",
      "log.tail"
    ],
    "rest": [
      {
        "method": "GET",
        "path": "/search",
        "iface": "jmcomic.search",
        "args": {
          "keyword": "?keyword",
          "page": "?page",
          "mode": "?mode"
        }
      },
      {
        "method": "GET",
        "path": "/meta/{aid}",
        "iface": "jmcomic.meta",
        "args": {
          "aid": "{aid}"
        }
      },
      {
        "method": "GET",
        "path": "/album/{aid}",
        "iface": "jmcomic.album",
        "args": {
          "aid": "{aid}"
        }
      },
      {
        "method": "GET",
        "path": "/chapter/{aid}/{cid}",
        "iface": "jmcomic.chapter",
        "args": {
          "aid": "{aid}",
          "cid": "{cid}"
        }
      },
      {
        "method": "GET",
        "path": "/cover/{aid}",
        "iface": "jmcomic.cover",
        "args": {
          "aid": "{aid}"
        },
        "file": "cover"
      },
      {
        "method": "GET",
        "path": "/image/{aid}/{cid}/{filename}",
        "iface": "jmcomic.image",
        "args": {
          "aid": "{aid}",
          "cid": "{cid}",
          "filename": "{filename}"
        },
        "file": "url"
      },
      {
        "method": "GET",
        "path": "/library",
        "iface": "jmcomic.library.list"
      },
      {
        "method": "DELETE",
        "path": "/library/{aid}",
        "iface": "jmcomic.library.delete",
        "args": {
          "aid": "{aid}"
        }
      },
      {
        "method": "POST",
        "path": "/download/{aid}",
        "iface": "jmcomic.download",
        "args": {
          "aid": "{aid}"
        }
      },
      {
        "method": "GET",
        "path": "/download/{aid}",
        "iface": "jmcomic.download.status",
        "args": {
          "aid": "{aid}"
        }
      },
      {
        "method": "POST",
        "path": "/download/batch",
        "iface": "jmcomic.batch.start",
        "args": {
          "mode": "body.mode",
          "keyword": "body.keyword"
        }
      },
      {
        "method": "GET",
        "path": "/download/batch",
        "iface": "jmcomic.batch.status"
      },
      {
        "method": "POST",
        "path": "/download/batch/stop",
        "iface": "jmcomic.batch.stop"
      },
      {
        "method": "POST",
        "path": "/dl/start",
        "iface": "jmcomic.dl.start",
        "args": {
          "aid": "body.aid",
          "name": "body.name",
          "author": "body.author",
          "workers": "body.workers"
        }
      },
      {
        "method": "GET",
        "path": "/dl/status",
        "iface": "jmcomic.dl.status",
        "args": {
          "aid": "?aid"
        }
      },
      {
        "method": "GET",
        "path": "/dl/list",
        "iface": "jmcomic.dl.list"
      },
      {
        "method": "POST",
        "path": "/dl/pause",
        "iface": "jmcomic.dl.pause",
        "args": {
          "aid": "body.aid"
        }
      },
      {
        "method": "POST",
        "path": "/dl/resume",
        "iface": "jmcomic.dl.resume",
        "args": {
          "aid": "body.aid"
        }
      },
      {
        "method": "POST",
        "path": "/dl/cancel",
        "iface": "jmcomic.dl.cancel",
        "args": {
          "aid": "body.aid"
        }
      },
      {
        "method": "POST",
        "path": "/dl/remove",
        "iface": "jmcomic.dl.remove",
        "args": {
          "aid": "body.aid",
          "delete_files": "body.delete_files"
        }
      },
      {
        "method": "POST",
        "path": "/dl/retry-failed",
        "iface": "jmcomic.dl.retry_failed",
        "args": {
          "aid": "body.aid"
        }
      }
    ],
    "rest_public": true
  },
  "interfaces": [
    {
      "id": "jmcomic.search",
      "visibility": "all",
      "version": "1",
      "description": "搜索"
    },
    {
      "id": "jmcomic.meta",
      "visibility": "all",
      "version": "1",
      "description": "漫画元信息"
    },
    {
      "id": "jmcomic.album",
      "visibility": "all",
      "version": "1",
      "description": "漫画详情+章节"
    },
    {
      "id": "jmcomic.chapter",
      "visibility": "all",
      "version": "1",
      "description": "章节图片列表"
    },
    {
      "id": "jmcomic.download",
      "visibility": "main",
      "version": "1",
      "description": "加入下载队列"
    },
    {
      "id": "jmcomic.download.status",
      "visibility": "all",
      "version": "1",
      "description": "下载进度"
    },
    {
      "id": "jmcomic.library.list",
      "visibility": "all",
      "version": "1",
      "description": "本地库"
    },
    {
      "id": "jmcomic.library.delete",
      "visibility": "main",
      "version": "1",
      "description": "删除本子"
    },
    {
      "id": "jmcomic.config.get",
      "visibility": "all",
      "version": "1",
      "description": "读取配置"
    },
    {
      "id": "jmcomic.config.save",
      "visibility": "main",
      "version": "1",
      "description": "保存配置"
    },
    {
      "id": "jmcomic.info",
      "visibility": "all",
      "version": "1",
      "description": "插件信息"
    },
    {
      "id": "jmcomic.image",
      "visibility": "all",
      "version": "1",
      "description": "按需取单张漫画图(base64)"
    },
    {
      "id": "jmcomic.cover",
      "visibility": "all",
      "version": "1",
      "description": "本子封面(缓存 cache/ 直出)"
    },
    {
      "id": "jmcomic.download.cancel",
      "visibility": "main",
      "version": "1",
      "description": "取消下载(排队立即/下载中标记后清残留)"
    },
    {
      "id": "jmcomic.covers",
      "visibility": "all",
      "version": "1",
      "description": "批量封面(一次取N个)"
    },
    {
      "id": "jmcomic.prefetch",
      "visibility": "all",
      "version": "1",
      "description": "章节图片批量预取(URL化)"
    },
    {
      "id": "jmcomic.perf.stats",
      "visibility": "all",
      "version": "1",
      "description": "性能统计(命中/解码/耗时采样)"
    },
    {
      "id": "jmcomic.batch.start",
      "visibility": "all",
      "version": "1",
      "description": "批量下载: 开始(按关键词/分类)"
    },
    {
      "id": "jmcomic.batch.status",
      "visibility": "all",
      "version": "1",
      "description": "批量下载: 进度"
    },
    {
      "id": "jmcomic.batch.stop",
      "visibility": "all",
      "version": "1",
      "description": "批量下载: 停止"
    },
    {
      "id": "jmcomic.dl.start",
      "visibility": "all",
      "version": "1",
      "description": "内置下载器：开始下载（按页并发/断点续传）"
    },
    {
      "id": "jmcomic.dl.status",
      "visibility": "all",
      "version": "1",
      "description": "内置下载器：单个任务进度"
    },
    {
      "id": "jmcomic.dl.list",
      "visibility": "all",
      "version": "1",
      "description": "内置下载器：全部任务"
    },
    {
      "id": "jmcomic.dl.pause",
      "visibility": "all",
      "version": "1",
      "description": "内置下载器：暂停"
    },
    {
      "id": "jmcomic.dl.resume",
      "visibility": "all",
      "version": "1",
      "description": "内置下载器：继续"
    },
    {
      "id": "jmcomic.dl.cancel",
      "visibility": "all",
      "version": "1",
      "description": "内置下载器：取消"
    },
    {
      "id": "jmcomic.dl.remove",
      "visibility": "all",
      "version": "1",
      "description": "内置下载器：移除任务（可选删文件）"
    },
    {
      "id": "jmcomic.dl.retry_failed",
      "visibility": "all",
      "version": "1",
      "description": "内置下载器：只补下失败的页"
    }
  ]
}